      <ellipse cx="15" cy="285" rx="16" ry="9" fill="#8fba9a" transform="rotate(-8 15 285)"/>
    </g>
    <!-- Small berries/dots -->
    <circle cx="165" cy="175" r="4" fill="#c9a040" opacity=".7"/>
    <circle cx="178" cy="168" r="3" fill="#c9a040" opacity=".6"/>
    <circle cx="330" cy="98" r="3.5" fill="#c9a040" opacity=".65"/>
