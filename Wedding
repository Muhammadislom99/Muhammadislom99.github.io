    <g transform="translate(95,245) rotate(-12)"><ellipse cx="0" cy="0" rx="26" ry="21" fill="#c97080" opacity=".8"/><ellipse cx="-6" cy="-8" rx="20" ry="15" fill="#d9919a" opacity=".75"/><ellipse cx="4" cy="-14" rx="14" ry="11" fill="#e8acb2" opacity=".7"/><ellipse cx="-2" cy="-18" rx="9" ry="7" fill="#f0c4c8" opacity=".65"/></g>
    <g transform="translate(88,130) rotate(5)"><ellipse cx="0" cy="0" rx="20" ry="16" fill="#d4818a" opacity=".72"/><ellipse cx="-5" cy="-6" rx="16" ry="12" fill="#e09aa2" opacity=".67"/><ellipse cx="3" cy="-11" rx="11" ry="8" fill="#eab5bb" opacity=".62"/></g>
    <ellipse cx="55" cy="415" rx="24" ry="13" fill="#5a8a6a" transform="rotate(-38 55 415)" opacity=".8"/>
    <ellipse cx="72" cy="398" rx="19" ry="10" fill="#8fba9a" transform="rotate(-52 72 398)" opacity=".75"/>
    <ellipse cx="100" cy="290" rx="22" ry="12" fill="#5a8a6a" transform="rotate(28 100 290)" opacity=".75"/>
    <ellipse cx="78" cy="170" rx="18" ry="10" fill="#8fba9a" transform="rotate(-22 78 170)" opacity=".7"/>
    <circle cx="88" cy="375" r="3" fill="#c9a040" opacity=".65"/>
    <circle cx="100" cy="230" r="2.5" fill="#c9a040" opacity=".55"/>
  </svg>
  <svg class="fl-r" viewBox="0 0 180 500" xmlns="http://www.w3.org/2000/svg">
