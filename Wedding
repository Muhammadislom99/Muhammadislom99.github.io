      <ellipse cx="3" cy="-28" rx="8" ry="6.5" fill="#f9e4e6" opacity=".7"/>
    </g>
    <!-- Rose 4 top right -->
    <g transform="translate(635,28) rotate(-8)">
      <ellipse cx="0" cy="0" rx="22" ry="18" fill="#c97080" opacity=".78"/>
      <ellipse cx="-5" cy="-7" rx="17" ry="13" fill="#d9919a" opacity=".73"/>
      <ellipse cx="3" cy="-12" rx="12" ry="9" fill="#e8acb2" opacity=".68"/>
      <ellipse cx="-2" cy="-15" rx="7" ry="6" fill="#f0c4c8" opacity=".63"/>
    </g>
    <!-- Small bud right -->
    <g transform="translate(400,80) rotate(20)">
      <ellipse cx="0" cy="0" rx="12" ry="9" fill="#d4818a" opacity=".7"/>
