<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Свадебное Приглашение</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Great+Vibes&family=Montserrat:wght@200;300;400;500&display=swap');
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:#fffdf9;font-family:'Montserrat',sans-serif;color:#2c2020;overflow-x:hidden}

#prog{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,#d4818a,#c9a040,#5a8a6a);z-index:200;transition:width .1s}
.dots{position:fixed;right:18px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:10px;z-index:200}
.dot{width:8px;height:8px;border-radius:50%;border:1.5px solid #d4818a;cursor:pointer;transition:all .3s;background:transparent}
.dot.active{background:#d4818a;transform:scale(1.4)}
#cv{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0}
.reveal{opacity:0;transform:translateY(40px);transition:opacity .9s ease,transform .9s ease}
.reveal.vis{opacity:1;transform:translateY(0)}
.reveal2{opacity:0;transform:translateY(30px);transition:opacity .9s ease,transform .9s ease}
.reveal2.vis{opacity:1;transform:translateY(0)}

/* ═══ HERO ═══ */
.hero{position:relative;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 20px;z-index:1;background:#fff;overflow:hidden}
.fl-t{position:absolute;top:0;left:50%;transform:translateX(-50%);width:min(760px,108vw);pointer-events:none;z-index:2}
.fl-b{position:absolute;bottom:0;left:50%;transform:translateX(-50%) scaleY(-1);width:min(760px,108vw);pointer-events:none;z-index:2}
.fl-l{position:absolute;left:-30px;top:50%;transform:translateY(-50%);width:180px;pointer-events:none;z-index:2;opacity:.7}
.fl-r{position:absolute;right:-30px;top:50%;transform:translateY(-50%) scaleX(-1);width:180px;pointer-events:none;z-index:2;opacity:.7}

.hero-inner{position:relative;z-index:3;display:flex;flex-direction:column;align-items:center;margin-top:220px;margin-bottom:60px}
.tag{font-size:9px;letter-spacing:7px;text-transform:uppercase;color:#5a8a6a;margin-bottom:18px;opacity:0;transform:translateY(14px);transition:all 1s .3s}
.names{font-family:'Great Vibes',cursive;font-size:clamp(60px,10.5vw,104px);color:#2c2020;line-height:1.05;opacity:0;transform:translateY(22px);transition:all 1.1s .5s;text-shadow:0 2px 30px rgba(212,129,138,.15)}
.amp{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:.52em;color:#d4818a;display:block;margin:-4px 0}
.div{display:flex;align-items:center;gap:12px;margin:20px 0;opacity:0;transition:all 1s .75s;justify-content:center}
.dl{width:70px;height:1px;background:linear-gradient(90deg,transparent,#c9a040)}
.dr{width:70px;height:1px;background:linear-gradient(90deg,#c9a040,transparent)}
.dd{width:5px;height:5px;border-radius:50%;background:#c9a040}

/* BIG date/venue */
.hero-date{font-family:'Cormorant Garamond',serif;font-size:clamp(22px,3.5vw,32px);letter-spacing:5px;color:#2c2020;font-weight:400;opacity:0;transition:all 1s 1s;margin-bottom:10px}
.hero-venue{font-family:'Cormorant Garamond',serif;font-size:clamp(19px,3vw,27px);letter-spacing:3px;color:#5a8a6a;font-weight:300;opacity:0;transition:all 1s 1.1s}
.hero-city{font-family:'Montserrat',sans-serif;font-size:10px;letter-spacing:6px;text-transform:uppercase;color:#d4818a;opacity:0;transition:all 1s 1.2s;margin-top:8px}

.scroll-hint{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:7px;opacity:0;transition:opacity 1s 2.2s;z-index:3}
.scroll-hint span{font-size:7px;letter-spacing:4px;text-transform:uppercase;color:#5a8a6a}
.arr{width:18px;height:18px;border-right:1px solid #5a8a6a;border-bottom:1px solid #5a8a6a;transform:rotate(45deg);animation:boun 2s infinite}
@keyframes boun{0%,100%{transform:rotate(45deg) translateY(0)}50%{transform:rotate(45deg) translateY(5px)}}
.loaded .tag,.loaded .names,.loaded .div,.loaded .hero-date,.loaded .hero-venue,.loaded .hero-city,.loaded .scroll-hint{opacity:1;transform:translateY(0)}

/* ═══ STORY SECTION ═══ */
.story{position:relative;z-index:1;padding:100px 20px;background:linear-gradient(180deg,#fff8f8 0%,#fff 100%);text-align:center;overflow:hidden}
.slabel{font-size:9px;letter-spacing:6px;text-transform:uppercase;color:#d4818a;margin-bottom:14px}
.stitle{font-family:'Great Vibes',cursive;font-size:clamp(44px,7vw,72px);color:#2c2020;margin-bottom:40px;line-height:1.2}
.story-text{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(17px,2.2vw,22px);color:#7a6060;max-width:560px;margin:0 auto;line-height:1.9;font-weight:300}

/* ═══ COUNTDOWN ═══ */
.cd-sec{position:relative;z-index:1;padding:100px 20px;background:linear-gradient(150deg,#1e3528 0%,#2d4838 60%,#1a2e22 100%);text-align:center;overflow:hidden}
.cd-deco{position:absolute;pointer-events:none;opacity:.2}
.cd-deco.tl{top:-40px;left:-40px;width:300px}
.cd-deco.tr{top:-40px;right:-40px;width:280px;transform:scaleX(-1)}
.cd-deco.bl{bottom:-40px;left:-40px;width:260px;transform:scaleY(-1)}
.cd-deco.br{bottom:-40px;right:-40px;width:270px;transform:scale(-1,-1)}
.cd-glow{position:absolute;inset:0;background:radial-gradient(ellipse at 30% 50%,rgba(212,129,138,.1) 0%,transparent 55%),radial-gradient(ellipse at 70% 50%,rgba(201,160,64,.07) 0%,transparent 55%)}
.cd-title{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(16px,2.5vw,24px);color:rgba(255,255,255,.7);letter-spacing:2px;margin-bottom:60px}
.cd-grid{display:flex;justify-content:center;gap:clamp(8px,3vw,44px);flex-wrap:wrap}
.ci{display:flex;flex-direction:column;align-items:center;gap:8px;min-width:70px}
.cn{font-family:'Cormorant Garamond',serif;font-size:clamp(56px,10vw,92px);font-weight:300;color:#fff;line-height:1;transition:transform .2s,color .2s;min-width:2ch;text-align:center}
.cn.flip{transform:scale(1.18);color:#f2b8be}
.cl{font-size:8px;letter-spacing:4px;text-transform:uppercase;color:rgba(255,255,255,.42)}
.csep{font-family:'Cormorant Garamond',serif;font-size:60px;color:rgba(212,129,138,.35);line-height:1;padding-top:12px}

/* ═══ DETAILS ═══ */
.det{position:relative;z-index:1;padding:110px 20px;background:#fff;text-align:center;overflow:hidden}
.det-bg-l{position:absolute;left:-50px;top:0;bottom:0;width:260px;pointer-events:none;opacity:.13}
.det-bg-r{position:absolute;right:-50px;top:0;bottom:0;width:260px;pointer-events:none;opacity:.13;transform:scaleX(-1)}
.cards{display:flex;justify-content:center;gap:24px;flex-wrap:wrap;max-width:900px;margin:0 auto}
.card{background:#fffdf9;border:1px solid rgba(212,129,138,.18);padding:48px 30px 40px;flex:1;min-width:200px;max-width:280px;border-radius:2px;position:relative;transition:transform .4s,box-shadow .4s}
.card::before{content:'';position:absolute;inset:7px;border:1px solid rgba(201,160,64,.1);border-radius:1px;pointer-events:none}
.card:hover{transform:translateY(-10px);box-shadow:0 24px 60px rgba(212,129,138,.14)}
.card-fl{position:absolute;top:-28px;left:50%;transform:translateX(-50%);width:56px;height:56px}
.ci-icon{width:48px;height:48px;margin:0 auto 16px;color:#d4818a}
.ct{font-size:9px;letter-spacing:4px;text-transform:uppercase;color:#5a8a6a;margin-bottom:10px}
/* BIG card main */
.cm{font-family:'Cormorant Garamond',serif;font-size:clamp(22px,3vw,28px);color:#2c2020;line-height:1.35;font-weight:400}
.cs{font-size:12px;color:#7a6060;margin-top:8px;font-weight:300;letter-spacing:1px}

/* ═══ TIMELINE ═══ */
.timeline{position:relative;z-index:1;padding:110px 20px;background:linear-gradient(180deg,#fff8f4 0%,#fff 100%);text-align:center;overflow:hidden}
.tl-line{position:absolute;left:50%;top:200px;bottom:80px;width:1px;background:linear-gradient(180deg,transparent,#d4818a 10%,#d4818a 90%,transparent);transform:translateX(-50%);opacity:.3}
.tl-items{max-width:700px;margin:0 auto;display:flex;flex-direction:column;gap:0}
.tl-item{display:flex;align-items:center;gap:30px;padding:30px 0}
.tl-item.r{flex-direction:row-reverse}
.tl-side{flex:1;text-align:right}
.tl-item.r .tl-side{text-align:left}
.tl-dot{width:14px;height:14px;border-radius:50%;background:#d4818a;flex-shrink:0;position:relative;z-index:2;box-shadow:0 0 0 4px rgba(212,129,138,.2)}
.tl-label{font-size:9px;letter-spacing:4px;text-transform:uppercase;color:#5a8a6a;margin-bottom:5px}
.tl-main{font-family:'Cormorant Garamond',serif;font-size:clamp(18px,2.5vw,24px);color:#2c2020;line-height:1.4}
.tl-sub{font-size:11px;color:#7a6060;margin-top:4px;letter-spacing:1px}

/* ═══ PALETTE ═══ */
.pal{position:relative;z-index:1;padding:110px 20px;background:#fff;text-align:center;overflow:hidden}
.pal-fl-t{position:absolute;top:-10px;left:50%;transform:translateX(-50%);width:min(600px,100vw);pointer-events:none;opacity:.35}
.pal-fl-b{position:absolute;bottom:-10px;left:50%;transform:translateX(-50%) scaleY(-1);width:min(600px,100vw);pointer-events:none;opacity:.35}
.palette{display:flex;justify-content:center;gap:18px;margin:44px 0 16px;flex-wrap:wrap}
.sw{display:flex;flex-direction:column;align-items:center;gap:10px;cursor:pointer;transition:transform .3s}
.sw:hover{transform:translateY(-7px)}
.sw-c{width:68px;height:68px;border-radius:50%;border:2px solid rgba(201,160,64,.22);transition:border-color .3s,box-shadow .3s;box-shadow:0 4px 14px rgba(0,0,0,.07)}
.sw:hover .sw-c{border-color:#c9a040;box-shadow:0 10px 26px rgba(201,160,64,.28)}
.sw-n{font-size:8px;letter-spacing:2px;text-transform:uppercase;color:#7a6060}

/* ═══ CLOSING ═══ */
.closing{position:relative;z-index:1;min-height:75vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:120px 20px;overflow:hidden;background:linear-gradient(135deg,#fff3f4 0%,#fffdf4 50%,#f0f8f2 100%)}
.cl-t{position:absolute;top:0;left:50%;transform:translateX(-50%);width:min(720px,108vw);pointer-events:none;opacity:.6}
.cl-b{position:absolute;bottom:0;left:50%;transform:translateX(-50%) scaleY(-1);width:min(720px,108vw);pointer-events:none;opacity:.6}
.cl-inner{position:relative;z-index:2;margin-top:80px}
.cq{font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(17px,2.5vw,24px);color:#7a6060;max-width:500px;line-height:1.9;margin-bottom:36px}
.gline{width:50px;height:1px;background:#c9a040;margin:22px auto;opacity:.55}
.cn-big{font-family:'Great Vibes',cursive;font-size:clamp(50px,8.5vw,90px);color:#2c2020;text-shadow:0 4px 24px rgba(212,129,138,.18)}
.btag{font-size:9px;letter-spacing:5px;text-transform:uppercase;color:#d4818a;margin-top:10px}

/* hearts floating */
@keyframes hFloat{0%{transform:translateY(0) scale(1)}50%{transform:translateY(-12px) scale(1.05)}100%{transform:translateY(0) scale(1)}}
.heart-deco{display:inline-block;color:#d4818a;opacity:.25;font-size:22px;animation:hFloat 3s ease-in-out infinite}
</style>
</head>
<body>
<div id="prog"></div>
<canvas id="cv"></canvas>
<nav class="dots" id="dots">
