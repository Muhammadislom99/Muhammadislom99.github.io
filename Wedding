<script>
window.addEventListener('load',()=>setTimeout(()=>{document.querySelector('.hero').classList.add('loaded');},120));

function upd(){
  const wed=new Date('2026-03-29T17:00:00'),now=new Date();let diff=wed-now;
  const set=(id,v)=>{const el=document.getElementById(id),s=String(v).padStart(2,'0');if(el.textContent!==s){el.classList.add('flip');setTimeout(()=>el.classList.remove('flip'),220);el.textContent=s;}};
  if(diff<=0){['cd-d','cd-h','cd-m','cd-s'].forEach(id=>document.getElementById(id).textContent='00');return;}
  const d=Math.floor(diff/864e5);diff-=d*864e5;const h=Math.floor(diff/36e5);diff-=h*36e5;const m=Math.floor(diff/6e4);diff-=m*6e4;const s=Math.floor(diff/1e3);
  set('cd-d',d);set('cd-h',h);set('cd-m',m);set('cd-s',s);
}
upd();setInterval(upd,1000);

const obs=new IntersectionObserver(ee=>ee.forEach(e=>{if(e.isIntersecting)e.target.classList.add('vis')}),{threshold:.12});
document.querySelectorAll('.reveal,.reveal2').forEach(r=>obs.observe(r));

window.addEventListener('scroll',()=>{const mx=document.body.scrollHeight-innerHeight;document.getElementById('prog').style.width=(scrollY/mx*100)+'%';});

const secs=['s0','s1','s2','s3','s4','s5','s6'].map(id=>document.getElementById(id));
const dots=document.querySelectorAll('.dot');
dots.forEach(d=>d.addEventListener('click',()=>secs[+d.dataset.s].scrollIntoView({behavior:'smooth'})));
const dObs=new IntersectionObserver(ee=>ee.forEach(e=>{if(e.isIntersecting){const i=secs.indexOf(e.target);dots.forEach((d,j)=>d.classList.toggle('active',i===j));}}),{threshold:.4});
secs.forEach(s=>dObs.observe(s));

// CANVAS petals
const cv=document.getElementById('cv'),ctx=cv.getContext('2d');
let W,H;
const rsz=()=>{W=cv.width=innerWidth;H=cv.height=innerHeight;};
rsz();window.addEventListener('resize',rsz);
class P{
  reset(init){this.x=Math.random()*W;this.y=init?Math.random()*H:-20;this.sz=4+Math.random()*11;this.sp=.4+Math.random()*.7;this.sw=(Math.random()-.5)*.5;this.a=Math.random()*Math.PI*2;this.sp2=(Math.random()-.5)*.036;this.op=.18+Math.random()*.28;this.c=['#d4818a','#e09aa2','#8fba9a','#5a8a6a','#f2cfd3','#c9a040','#eab5bb'][Math.floor(Math.random()*7)];this.t=Math.random()>.35?'leaf':'petal';this.wb=0;this.wbs=.018+Math.random()*.02;}
  constructor(){this.reset(true);}
  draw(){
    ctx.save();ctx.translate(this.x,this.y);ctx.rotate(this.a);ctx.globalAlpha=this.op;ctx.fillStyle=this.c;
    if(this.t==='leaf'){ctx.beginPath();ctx.moveTo(0,-this.sz);ctx.bezierCurveTo(this.sz*.65,-this.sz*.5,this.sz*.65,this.sz*.5,0,this.sz);ctx.bezierCurveTo(-this.sz*.65,this.sz*.5,-this.sz*.65,-this.sz*.5,0,-this.sz);ctx.fill();ctx.strokeStyle='rgba(255,255,255,.15)';ctx.lineWidth=.4;ctx.beginPath();ctx.moveTo(0,-this.sz*.7);ctx.lineTo(0,this.sz*.7);ctx.stroke();}
    else{ctx.beginPath();for(let i=0;i<5;i++){const ang=(i*2*Math.PI/5)-Math.PI/2,r=i%2===0?this.sz:this.sz*.45;i===0?ctx.moveTo(Math.cos(ang)*r,Math.sin(ang)*r):ctx.lineTo(Math.cos(ang)*r,Math.sin(ang)*r);}ctx.closePath();ctx.fill();}
    ctx.restore();
  }
  update(){this.wb+=this.wbs;this.x+=Math.sin(this.wb)*.7+this.sw;this.y+=this.sp;this.a+=this.sp2;if(this.y>H+30)this.reset(false);}
}
const parts=Array.from({length:38},()=>new P());
(function loop(){ctx.clearRect(0,0,W,H);parts.forEach(p=>{p.update();p.draw();});requestAnimationFrame(loop);})();
</script>
